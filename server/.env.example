# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB Atlas or Local MongoDB)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/deepak_portfolio?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/deepak_portfolio

# JWT Secret for Admin Authentication
JWT_SECRET=replace_with_a_long_random_secret

# Admin Credentials (for initial setup & project management)
ADMIN_EMAIL=your_admin_email@example.com
ADMIN_PASSWORD=replace_with_a_unique_strong_password

# Nodemailer / SMTP Configuration
# For Gmail: Use an App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=rjdeepu00@gmail.com
SMTP_PASS=your_gmail_app_password_here
NOTIFICATION_EMAIL=rjdeepu00@gmail.com
